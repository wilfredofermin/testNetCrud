{
  "info": {
    "name": "testNet API - Products CRUD",
    "description": "Colección de endpoints para la gestión de productos en testNet",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('productId', jsonData.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"PRD-001\",\n  \"name\": \"Laptop Gamer\",\n  \"description\": \"Laptop de alta gama\",\n  \"price\": 1500.00,\n  \"stockQuantity\": 10,\n  \"currency\": \"USD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      }
    },
    {
      "name": "Get All Products",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      }
    },
    {
      "name": "Get Active Products",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/products/active",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "active"]
        }
      }
    },
    {
      "name": "Get Products Paged",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/products/paged?page=1&pageSize=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "paged"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "pageSize", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "Get Product By ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      }
    },
    {
      "name": "Get Product By Code",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/products/code/PRD-001",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "code", "PRD-001"]
        }
      }
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop Gamer Pro\",\n  \"description\": \"Versión mejorada\",\n  \"price\": 1800.00,\n  \"stockQuantity\": 15,\n  \"currency\": \"USD\",\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      }
    },
    {
      "name": "Add Stock",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 50\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}/stock/add",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}", "stock", "add"]
        }
      }
    },
    {
      "name": "Remove Stock",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}/stock/remove",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}", "stock", "remove"]
        }
      }
    },
    {
      "name": "Delete Product",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      }
    }
  ]
}
